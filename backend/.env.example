# ─────────────────────────────────────────────────────────────────
# pharmaLocator Backend — Environment Variables
# Copy this file to .env and fill in the real values
# NEVER commit .env to git
# ─────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=production

# Comma-separated list of allowed frontend origins (no trailing slash)
# Example: https://pharmalocator.vercel.app,https://www.pharmalocator.com
CORS_ORIGIN=frontend_vercel

# The public URL of this API (used in logs & OAuth redirect fallback)
API_BASE_URL=https://vercel

# ── Database ──────────────────────────────────────────────────────
MONGODB_URI=mongodb+srv://user:password@cluster0.xxxx.mongodb.net/pharma_locator?appName=Cluster0
# ── Auth ──────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=random_variables

# ── Google OAuth ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=clint_id
GOOGLE_CLIENT_SECRET=your_google_id
# Must match the URI registered in Google Cloud Console
GOOGLE_REDIRECT_URI=https://Yourbackend.e=render.com/api/v1/auth/google/callback

# The frontend URL Google should redirect to after OAuth
FRONTEND_URL=your vercel

# ── Monitoring (optional) ─────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
LOG_LEVEL=info

# ── Rate Limiting ─────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
